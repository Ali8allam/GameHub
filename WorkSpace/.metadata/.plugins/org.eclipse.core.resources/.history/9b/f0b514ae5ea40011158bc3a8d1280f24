#include "../LIB/STD_TYPES.h"
#include "../LIB/BIT_MATH.h"

#include "../MCAL/RCC/RCC_int.h"
#include "../MCAL/GPIO/GPIO_int.h"
#include "../MCAL/NVIC/NVIC_int.h"
#include "../MCAL/EXTI/EXTI_int.h"
#include "../MCAL/SYSCFG/SYSCFG_int.h"
#include "../MCAL/SYSTICK/SYSTICK_int.h"

#include "../HAL/DAC/DAC_int.h"

/* Audio array declarations (generated raw PCM bytes) */
extern const u8 raw_audio[];
extern const u32 raw_audio_len;

static volatile u32 G_u32SampleIndex = 0;
static volatile u8  G_u8PlayFlag     = 0;

/* SysTick Callback: Executes periodically at the audio sample rate */
void Play_Audio_Sample(void)
{
    if (G_u8PlayFlag == 1)
    {
        if (G_u32SampleIndex < raw_audio_len)
        {
            HDAC_vSendSample(raw_audio, G_u32SampleIndex);
            G_u32SampleIndex++;
        }
        else
        {
            /* Song finished: reset index and stop playback */
            G_u8PlayFlag = 0;
            G_u32SampleIndex = 0;
        }
    }
}

/* EXTI Callback: Triggered when PB0 is pressed */
void Button_EXTI_Callback(void)
{
    G_u32SampleIndex = 0;
    G_u8PlayFlag = 1;
}

int main(void)
{
    /* 1. Initialize Clocks */
    MRCC_vInit();
    MRCC_vEnableCLK(RCC_AHB1, RCC_GPIOA);
    MRCC_vEnableCLK(RCC_AHB1, RCC_GPIOB);
    MRCC_vEnableCLK(RCC_APB2, 14); // SYSCFG Clock


    GPIOx_PinConfig_t dacPins[8];
    for (u8 i = 0; i < 8; i++)
    {
        dacPins[i].Port       = GPIO_PORTA;
        dacPins[i].Pin        = i;
        dacPins[i].Mode       = GPIO_MODE_OUTPUT;
        dacPins[i].OutputType = GPIO_OT_PUSHPULL;
        dacPins[i].Speed      = GPIO_SPEED_LOW;
        dacPins[i].PullType   = GPIO_NO_PULL;
    }


    HDAC_vInit(dacPins, 8);


    GPIOx_PinConfig_t button = {
        .Port     = GPIO_PORTB,
        .Pin      = GPIO_PIN0,
        .Mode     = GPIO_MODE_INPUT,
        .PullType = GPIO_PULL_UP
    };
    MGPIO_vPinInit(&button);

    /* 4. Configure EXTI Line 0 */
    MSYSCFG_vSetEXTIPort(EXTI_LINE0, SYSCFG_PORTB);
    MEXTI_vSetCallBack(Button_EXTI_Callback, EXTI_LINE0);
    MEXTI_vEnableINT(EXTI_LINE0);
    MEXTI_vSetTrigger(EXTI_LINE0, EXTI_FALLING_EDGE);
    MEXTI_vInit();

    /* 5. Enable EXTI0 in NVIC (Position 6) */
    MNVIC_vEnable_Peripheral_INT(6);

    /* 6. Start SysTick Periodic Interval (e.g., 125 us for 8 kHz sample rate) */
    MSYSTICK_vSetIntervalSigle(125000, Play_Audio_Sample);

    while (1)
    {

    }

    return 0;
}
